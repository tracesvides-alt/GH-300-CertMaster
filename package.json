{
  "name": "gh300-certmaster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "explanations:check": "node scripts/check-answer-explanations.mjs && node scripts/check-official-alignment.mjs && node scripts/check-foundation-cli-admin.mjs",
    "foundation:check": "node scripts/check-foundation-cli-admin.mjs",
    "alignment:check": "node scripts/check-official-alignment.mjs",
    "syllabus:check": "node scripts/check-syllabus.mjs",
    "sources:check": "node scripts/check-official-sources.mjs",
    "content:audit": "node scripts/audit-learning-content.mjs",
    "practice:coverage": "node scripts/audit-official-practice-coverage.mjs",
    "quality:audit": "node scripts/audit-questions.mjs",
    "quality:check": "node scripts/audit-questions.mjs --check",
    "choice:audit": "node scripts/audit-choice-quality.mjs",
    "multi:audit": "node scripts/audit-multi-select.mjs",
    "difficulty:audit": "node scripts/audit-question-difficulty.mjs",
    "difficulty:check": "node scripts/audit-question-difficulty.mjs --check",
    "classification:check": "node scripts/audit-question-classification.mjs",
    "feature:check": "node scripts/check-feature-refresh.mjs",
    "glossary:coverage": "node scripts/audit-glossary-coverage.mjs",
    "glossary:coverage:strict": "node scripts/audit-glossary-coverage.mjs --strict",
    "glossary:sync": "node scripts/sync-glossary-basic-questions.mjs",
    "foundation:audit": "node scripts/audit-foundation-glossary.mjs",
    "applied:sync": "node scripts/sync-applied-questions.mjs",
    "applied:audit": "node scripts/audit-applied-question-review.mjs",
    "applied:check": "node scripts/audit-applied-question-review.mjs --check",
    "applied:cleanup:check": "node scripts/check-applied-cleanup.mjs",
    "applied:remediation:check": "node scripts/check-applied-remediation.mjs",
    "applied:focus:check": "node scripts/check-applied-focus.mjs",
    "exam:sync": "node scripts/sync-exam-questions.mjs",
    "exam:audit": "node scripts/audit-exam-question-review.mjs",
    "exam:check": "node scripts/audit-exam-question-review.mjs --check"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "~16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
